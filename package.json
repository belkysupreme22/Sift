    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "grammy": "^1.34.1",
    "lucide-svelte": "^0.475.0",
    "pg": "^8.13.3",
    "tailwind-merge": "^3.0.1",
    "telegram": "^2.26.16"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.17.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "postcss": "^8.5.2",
    "svelte": "^5.20.2",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^3.4.17",
