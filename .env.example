# PostgreSQL Connection String (Alet Solo managed database or local Postgres)
DATABASE_URL="postgres://postgres:password@localhost:5432/sift"
# Set to 'false' if running against local postgres without SSL
DATABASE_SSL="false"

# Telegram Bot Token from @BotFather (e.g. @sift_timeline_bot)
BOT_TOKEN="1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ"

# Telegram API ID & Hash from https://my.telegram.org (App Configuration)
TG_API_ID="1234567"
TG_API_HASH="0123456789abcdef0123456789abcdef"

# Optional: Channels filter. If left empty/unset, Sift automatically syncs ALL channels you are subscribed to.
# CHANNELS_ALLOWLIST="@telegram, @durov"

# Web App URL (Reachable URL for Telegram Mini App button)
# In production on Alet: https://<your-app-name>.alet.app
# Locally: http://localhost:3000
WEBAPP_URL="http://localhost:3000"

# Server Port (Alet injects PORT automatically, binds 0.0.0.0)
PORT="3000"
