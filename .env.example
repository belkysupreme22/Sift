# ==========================================
# Sift Environment Configuration
# ==========================================

# PostgreSQL Database Connection
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Telegram Bot API Token (from @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram MTProto API Credentials (from https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef

# Public Web / Telegram Mini App URL (e.g. https://sift-timeline.app.aletcloud.com)
WEBAPP_URL=https://sift-timeline.app.aletcloud.com

# Comma-separated list of Telegram channel handles or IDs to track (e.g. @channel1,@channel2)
# If empty, all channels the connected account is subscribed to will be tracked.
TRACKED_CHANNELS=@channel1,@channel2
